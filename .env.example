# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and MUST NEVER be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Cloud alternative
# ─────────────────────────────────────────────────────────────────────────────
# If you are deploying to Streamlit Community Cloud, do NOT use a .env file.
# Instead, add the secret via the Streamlit dashboard:
#   App settings → Secrets → paste:
#
# GEMINI_API_KEY = "your_gemini_api_key_here"
